# ─────────────────────────────────────────────────────────────────────────
# Copier ce fichier en .env (dev) ou fournir ces valeurs au conteneur via
# `docker run --env-file .env` / `-e VAR=valeur` (prod) — toutes lues au
# RUNTIME par src/config/assert-env.ts, qui refuse de démarrer si l'une
# d'elles manque. Contrairement au frontend, rien à passer en --build-arg.
#
# Règle : chaque URL ne contient QUE l'origine du service (schéma + hôte +
# port), jamais de chemin/préfixe — c'est le code applicatif qui connaît et
# ajoute le chemin de chaque route. Ce fichier ne liste que les noms des
# variables, sans valeur : voir le README pour des exemples.
# ─────────────────────────────────────────────────────────────────────────

# Port d'écoute du serveur (optionnel, 3333 par défaut)
BACKEND_PORT=

# Préfixe des routes API (optionnel, "consultation/api" par défaut)
API_PREFIX=

# Connexion PostgreSQL
DATABASE_URL=

# Secret de signature des JWT — doit être identique à celui utilisé par le
# service auth (même algorithme de vérification des tokens SSO partagés
# entre tous les services du CHU). Ne jamais réutiliser une valeur d'exemple.
JWT_SECRET=

# Token utilisé pour les appels serveur-à-serveur authentifiés
# (registre service-service, endpoints publics appelés par le service
# accueil, etc.)
SERVICE_API_TOKEN=

# Origine de la passerelle unique du CHU (https://gateway-bwm4.onrender.com) —
# UNE SEULE variable pour auth, chu, prise-en-charge, services (registre),
# accueil et clinique (toutes lues avec `GATEWAY_URL` dans le code, jamais
# une variable par service : elles pointaient toutes vers la même origine).
# Ainsi la suspension d'un service individuel sur Render n'oblige plus à
# changer une variable ici — seule la suspension de la passerelle elle-même
# nous concernerait. La passerelle ne réécrit pas les chemins : elle
# transmet le chemin entrant tel quel au service réel, donc chaque route
# appelée dans le code est déjà le chemin réel du service (pas de préfixe
# "/service/" ajouté) — vérifié route par route en environnement réel :
# /auth/..., /roles, /permissions, /chu, /prise-en-charge, /services,
# /accueil/..., /clinique/.... Seuls accueil et clinique sont gardés par un
# JWT à la passerelle elle-même (requiresAuth dans son registre) ; auth/chu/
# services ne le sont pas (c'est le service d'origine qui gère sa propre
# authentification, identique à un appel direct). Dans tous les cas, le JWT
# du médecin connecté est toujours transmis (aucun appel de ce backend vers
# ces services ne se fait depuis un contexte anonyme).
GATEWAY_URL=
# Exception : sert UNIQUEMENT à valider un token entrant (bootstrap de
# l'authentification côté auth.service.ts) — ne peut pas passer par la
# passerelle, qui exige elle-même un JWT déjà valide (dépendance circulaire).
# Reste donc en appel direct au service utilisateurs.
AUTH_USER_SERVICE_URL=
# Double rôle : notifyOurService() y pousse nos propres événements, ET
# src/notification/ (service + gateway) la relaie au frontend (historique
# REST + WebSocket temps réel) pour qu'aucune variable NEXT_PUBLIC_* de
# service externe ne soit nécessaire côté frontend, seulement la passerelle.
# Reste en appel direct : notifyOurService() n'envoie aucun token, et la
# passerelle exige un JWT (ou SERVICE_API_TOKEN) sur ce service — migration
# possible une fois SERVICE_API_TOKEN synchronisé entre ce backend et la
# passerelle sur Render (voir SERVICE_API_TOKEN ci-dessus).
NOTIFICATION_URL=

# ── Identité de ce déploiement (pas des données utilisateur : rien dans un
# token ne dit "quel CHU/service suis-je", donc ça reste en configuration
# locale — un déploiement = un CHU) ──
CHU_ID=
CONSULTATION_EXTERNE_SERVICE_ID=
ACCUEIL_SERVICE_ID=

# Origine du service pharmacie (optionnelle : catalogue pharmacie dégradé
# en liste vide si absente, jamais bloquant au démarrage). Relayée
# serveur-à-serveur — le service pharmacie ne renvoie aucun en-tête CORS,
# donc le frontend ne peut plus l'appeler directement depuis le navigateur.
PHARMACIE_URL=

# Origine du service prescription (optionnelle au démarrage — son absence ne
# bloque jamais le boot, mais chaque appel relayé échoue en 503 tant qu'elle
# n'est pas définie). Relayée serveur-à-serveur via /prescription/* (proxy
# générique, voir src/prescription/) : reste en appel direct pour centraliser
# les 21 endpoints du service derrière une seule route générique, plutôt que
# de dupliquer sa surface d'API dans le registre de la passerelle.
PRESCRIPTION_URL=
