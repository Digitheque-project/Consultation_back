# ─────────────────────────────────────────────────────────────────────────
# Copier ce fichier en .env (dev) ou fournir ces valeurs au conteneur via
# `docker run --env-file .env` / `-e VAR=valeur` (prod) — toutes lues au
# RUNTIME par src/config/assert-env.ts, qui refuse de démarrer si l'une
# d'elles manque. Contrairement au frontend, rien à passer en --build-arg.
#
# Règle : chaque URL ne contient QUE l'origine du service (schéma + hôte +
# port), jamais de chemin/préfixe — c'est le code applicatif qui connaît et
# ajoute le chemin de chaque route. Ce fichier ne liste que les noms des
# variables, sans valeur : voir le README pour des exemples.
# ─────────────────────────────────────────────────────────────────────────

# Port d'écoute du serveur (optionnel, 3333 par défaut)
BACKEND_PORT=

# Préfixe des routes API (optionnel, "consultation/api" par défaut)
API_PREFIX=

# Connexion PostgreSQL
DATABASE_URL=

# Secret de signature des JWT — doit être identique à celui utilisé par le
# service auth (même algorithme de vérification des tokens SSO partagés
# entre tous les services du CHU). Ne jamais réutiliser une valeur d'exemple.
JWT_SECRET=

# Token utilisé pour les appels serveur-à-serveur authentifiés
# (registre service-service, endpoints publics appelés par le service
# accueil, etc.)
SERVICE_API_TOKEN=

# ── Origines des autres services du CHU (réseau local ou cloud selon ce
# qui est déjà déployé) — origine seule, sans chemin ──
AUTH_SERVICE_URL=
AUTH_USER_SERVICE_URL=
ACCUEIL_BASE_URL=
CLINIQUE_BASE_URL=
CHU_SERVICE_BASE_URL=
NOTIFICATION_URL=
SERVICE_SERVICE_BASE_URL=

# ── Identité de ce déploiement (pas des données utilisateur : rien dans un
# token ne dit "quel CHU/service suis-je", donc ça reste en configuration
# locale — un déploiement = un CHU) ──
CHU_ID=
CONSULTATION_EXTERNE_SERVICE_ID=
ACCUEIL_SERVICE_ID=

# Origine du service pharmacie (optionnelle : catalogue pharmacie dégradé
# en liste vide si absente, jamais bloquant au démarrage). Relayée
# serveur-à-serveur — le service pharmacie ne renvoie aucun en-tête CORS,
# donc le frontend ne peut plus l'appeler directement depuis le navigateur.
PHARMACIE_URL=
