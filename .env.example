# ─────────────────────────────────────────────────────────────────────────
# Copier ce fichier en .env (dev) ou fournir ces valeurs au conteneur via
# `docker run --env-file .env` / `-e VAR=valeur` (prod) — toutes lues au
# RUNTIME par src/config/assert-env.ts, qui refuse de démarrer si l'une
# d'elles manque. Contrairement au frontend, rien à passer en --build-arg.
# ─────────────────────────────────────────────────────────────────────────

# Port d'écoute du serveur (optionnel, 3333 par défaut)
BACKEND_PORT=3333

# Préfixe des routes API (optionnel, "consultation/api" par défaut)
# API_PREFIX=consultation/api

# Connexion PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/consultation_externe

# Secret de signature des JWT — doit être identique à celui utilisé par le
# service auth (même algorithme de vérification des tokens SSO partagés
# entre tous les services du CHU). Ne jamais réutiliser une valeur d'exemple.
JWT_SECRET=

# Token utilisé pour les appels serveur-à-serveur authentifiés
# (registre service-service, etc.)
SERVICE_API_TOKEN=

# ── URLs des autres services du CHU (réseau local ou cloud selon ce qui
# est déjà déployé — ajuster host/port en fonction de l'infrastructure) ──
AUTH_SERVICE_URL=http://auth-service.local
AUTH_USER_SERVICE_URL=http://auth-service.local
ACCUEIL_BASE_URL=http://accueil-back.local
CLINIQUE_BASE_URL=http://clinique-back.local
CHU_SERVICE_BASE_URL=http://chu-service.local
NOTIFICATION_URL=http://notification-back.local
SERVICE_SERVICE_BASE_URL=http://service-service.local

# ── Identifiants du registre service-service (UUID propres à ce CHU) ──
# Valeurs réelles connues pour CHU Andrainjato Fianarantsoa — à confirmer
# auprès du registre service-service si ce déploiement cible un autre CHU.
CHU_ID=1e5bbbb7-fa10-4d59-8848-2d0ce96a9394
CONSULTATION_EXTERNE_SERVICE_ID=de3164f7-14c9-463d-99d0-3f6f8cad82c7
ACCUEIL_SERVICE_ID=a6ae8016-678c-4e13-b9d7-0afd735702d8
